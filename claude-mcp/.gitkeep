FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY server.py .
ENV PORT=8000
CMD ["sh", "-c", "uvicorn server:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
mcp==2.2.0
httpx==0.28.1
beautifulsoup4==4.12.3
pydantic==2.10.4
uvicorn[standard]==0.34.0
from __future__ import annotations

import hashlib
import re
from urllib.parse import urlparse

import httpx
from bs4 import BeautifulSoup
from mcp.server import MCPServer
from mcp.server.transport_security import TransportSecuritySettings
from pydantic import HttpUrl
from starlette.requests import Request
from starlette.responses import JSONResponse

APP_VERSION = "1.4.0-claude"
TC_SEARCH_URL = "https://www.tribunalconstitucional.gob.do/consultas/secretar%C3%ADa/sentencias/"
SCJ_PORTAL_URL = "https://consultasentenciascj.poderjudicial.gob.do/"
ALLOWED_HOST_SUFFIXES = (
    "tribunalconstitucional.gob.do",
    "poderjudicial.gob.do",
    "consultasentenciascj.poderjudicial.gob.do",
    "tribunalsitestorage.blob.core.windows.net",
)

mcp = MCPServer(
    "ELCOHE-JURIS RD",
    instructions=(
        "Herramientas de investigación jurisprudencial dominicana. "
        "Los resultados de búsqueda son candidatos: no atribuir ratio decidendi "
        "hasta verificar y leer el documento oficial."
    ),
    version=APP_VERSION,
)


def allowed_host(host: str | None) -> bool:
    if not host:
        return False
    host = host.lower().strip(".")
    return any(host == suffix or host.endswith("." + suffix) for suffix in ALLOWED_HOST_SUFFIXES)


def normalize_space(value: str | None) -> str | None:
    if value is None:
        return None
    return re.sub(r"\s+", " ", value).strip()


def tc_candidate_links(html: str, limit: int) -> list[dict]:
    soup = BeautifulSoup(html, "html.parser")
    results: list[dict] = []
    seen: set[str] = set()
    pattern = re.compile(r"TC/\d{3,4}/\d{2}", re.I)

    for a in soup.find_all("a", href=True):
        text = normalize_space(a.get_text(" ", strip=True)) or ""
        match = pattern.search(text)
        if not match:
            continue

        number = match.group(0).upper()
        href = a["href"]
        if href.startswith("/"):
            href = "https://www.tribunalconstitucional.gob.do" + href
        if href in seen:
            continue

        seen.add(href)
        parent_text = normalize_space(a.parent.get_text(" ", strip=True) if a.parent else text)
        date_match = re.search(r"\b\d{2}-\d{2}-\d{4}\b", parent_text or "")
        ref_match = re.search(r"TC-\d{2}-\d{4}-\d{4}", parent_text or "", re.I)

        results.append({
            "court": "TC",
            "decision_number": number,
            "date": date_match.group(0) if date_match else None,
            "reference": ref_match.group(0).upper() if ref_match else None,
            "relative_to": parent_text,
            "source_url": href,
            "status": "LOCATED",
            "note": (
                "Localizada en el portal oficial del Tribunal Constitucional. "
                "Verifique y lea el documento antes de atribuir ratio decidendi."
            ),
        })
        if len(results) >= limit:
            break
    return results


@mcp.tool()
def health_check() -> dict:
    """Comprueba si el servicio ELCOHE-JURIS RD MCP está activo."""
    return {
        "ok": True,
        "service": "ELCOHE-JURIS RD MCP",
        "version": APP_VERSION,
    }


@mcp.tool()
async def search_tc_decisions(q: str, year: int | None = None, limit: int = 10) -> dict:
    """Busca decisiones candidatas del Tribunal Constitucional dominicano. Use para jurisprudencia TC; no atribuya criterio hasta verificar y leer la decisión oficial."""
    if len(q.strip()) < 2:
        return {"status": "ERROR", "message": "La consulta debe contener al menos 2 caracteres."}
    limit = min(max(limit, 1), 20)
    if year is not None and not (2012 <= year <= 2100):
        return {"status": "ERROR", "message": "Año fuera de rango."}

    params = {"searchString": q, "searchCriteria": "", "size": max(limit, 10)}
    if year:
        params["searchString"] = f"{q} {year}"

    try:
        async with httpx.AsyncClient(
            timeout=20,
            follow_redirects=True,
            headers={"User-Agent": "ELCOHE-JURIS-RD-MCP/1.4"},
        ) as client:
            resp = await client.get(TC_SEARCH_URL, params=params)
            resp.raise_for_status()
    except httpx.HTTPError as exc:
        return {
            "status": "ERROR",
            "message": f"No fue posible consultar el portal oficial del TC: {exc}",
        }

    return {
        "query": q,
        "source": str(resp.url),
        "results": tc_candidate_links(resp.text, limit),
        "status": "LOCATED_RESULTS",
        "warning": (
            "Los resultados son candidatos localizados en fuente oficial. "
            "Verifique y lea el documento antes de citar una regla jurídica."
        ),
    }


@mcp.tool()
def prepare_scj_search(
    q: str,
    chamber: str | None = None,
    matter: str | None = None,
    year_from: int | None = None,
    year_to: int | None = None,
) -> dict:
    """Prepara una estrategia de búsqueda para jurisprudencia de la Suprema Corte de Justicia. El resultado es un plan, no una sentencia verificada."""
    if len(q.strip()) < 2:
        return {"status": "ERROR", "message": "La consulta debe contener al menos 2 caracteres."}
    if year_from and year_to and year_from > year_to:
        return {"status": "ERROR", "message": "year_from no puede ser mayor que year_to."}

    filters = {
        "sala": chamber,
        "materia": matter,
        "desde": year_from,
        "hasta": year_to,
    }
    filters = {k: v for k, v in filters.items() if v is not None}

    site_q = f'site:poderjudicial.gob.do "{q}"'
    if chamber:
        site_q += f' "{chamber}"'
    if matter:
        site_q += f' "{matter}"'

    return {
        "query": q,
        "official_portal": SCJ_PORTAL_URL,
        "filters": filters,
        "search_steps": [
            "Abrir el buscador oficial de la SCJ.",
            "Aplicar Sala, Materia y rango temporal cuando estén disponibles.",
            "Buscar primero por número de sentencia/expediente si existe.",
            "De lo contrario, usar términos jurídicos específicos.",
            "Localizar candidatos en poderjudicial.gob.do.",
            "Abrir y verificar la decisión antes de atribuir criterio.",
        ],
        "web_queries": [
            site_q,
            f'site:poderjudicial.gob.do/wp-content/uploads "{q}" sentencia',
        ],
        "status": "SEARCH_PLAN_ONLY",
        "warning": (
            "Este resultado no constituye jurisprudencia localizada ni verificada. "
            "La interfaz oficial SCJ es dinámica."
        ),
    }


@mcp.tool()
async def verify_official_document(
    url: str,
    expected_court: str | None = None,
    expected_number: str | None = None,
) -> dict:
    """Verifica si una URL de sentencia pertenece a una fuente jurídica oficial dominicana y devuelve metadatos. No identifica por sí sola la ratio decidendi."""
    try:
        parsed_input = HttpUrl(url)
        url = str(parsed_input)
    except Exception:
        return {"status": "REJECTED", "message": "URL inválida."}

    parsed = urlparse(url)
    if parsed.scheme != "https" or not allowed_host(parsed.hostname):
        return {
            "status": "REJECTED",
            "official_domain": False,
            "url": url,
            "note": "La URL debe ser HTTPS y pertenecer a un dominio oficial permitido.",
        }

    try:
        async with httpx.AsyncClient(
            timeout=25,
            follow_redirects=True,
            headers={"User-Agent": "ELCOHE-JURIS-RD-MCP/1.4"},
        ) as client:
            resp = await client.get(url)
    except httpx.HTTPError as exc:
        return {
            "status": "NOT_VERIFIED",
            "official_domain": True,
            "court": expected_court,
            "url": url,
            "note": f"Dominio oficial, pero no fue posible obtener el documento: {exc}",
        }

    final_url = str(resp.url)
    final_host = urlparse(final_url).hostname
    if not allowed_host(final_host):
        return {
            "status": "REJECTED",
            "official_domain": False,
            "url": url,
            "final_url": final_url,
            "note": "La redirección terminó fuera de los dominios oficiales permitidos.",
        }

    data = resp.content
    content_type = (resp.headers.get("content-type") or "").split(";")[0].lower()
    title = None
    text_sample = ""

    if "html" in content_type:
        soup = BeautifulSoup(resp.text, "html.parser")
        title = normalize_space(soup.title.get_text(" ", strip=True) if soup.title else None)
        text_sample = normalize_space(soup.get_text(" ", strip=True)) or ""

    number_pattern = re.compile(
        r"(?:TC/\d{3,4}/\d{2}|SCJ-[A-Z]{2}-\d{2}-\d{3,5}|"
        r"\bSentencia\s+(?:núm\.?|No\.?)\s*[A-Za-z0-9-]+)",
        re.I,
    )
    detected = None
    if text_sample:
        m = number_pattern.search(text_sample[:250000])
        detected = normalize_space(m.group(0)) if m else None

    expected_match = None
    if expected_number:
        haystack = (detected or "") + " " + text_sample[:250000]
        expected_match = expected_number.lower().replace(" ", "") in haystack.lower().replace(" ", "")

    ok_status = 200 <= resp.status_code < 300
    status = (
        "VERIFIED_SOURCE"
        if ok_status and ("pdf" in content_type or "html" in content_type)
        else "LOCATED_OFFICIAL"
    )
    note = (
        "Fuente oficial obtenida. La verificación de fuente no equivale "
        "a identificar la ratio decidendi."
    )

    if expected_match is False:
        status = "NOT_VERIFIED"
        note = (
            "La fuente es oficial, pero no se encontró el número esperado en "
            "el contenido accesible. Revise manualmente el documento."
        )

    court = expected_court
    if not court:
        if "tribunalconstitucional" in (final_host or "") or "tribunalsitestorage" in (final_host or ""):
            court = "TC"
        elif "poderjudicial" in (final_host or ""):
            court = "SCJ"

    return {
        "status": status,
        "official_domain": True,
        "court": court,
        "url": url,
        "final_url": final_url,
        "http_status": resp.status_code,
        "content_type": content_type or None,
        "title": title,
        "detected_number": detected,
        "expected_number_match": expected_match,
        "sha256": hashlib.sha256(data).hexdigest() if data else None,
        "note": note,
    }


@mcp.custom_route("/health", methods=["GET"])
async def http_health(request: Request):
    return JSONResponse({
        "ok": True,
        "service": "ELCOHE-JURIS RD MCP",
        "version": APP_VERSION,
    })


# Render termina TLS y controla el Host. Las herramientas son de solo lectura y no
# acceden a información privada, por lo que desactivamos la protección DNS-rebinding
# en este primer despliegue para evitar errores 421 detrás del proxy.
security = TransportSecuritySettings(enable_dns_rebinding_protection=False)

app = mcp.streamable_http_app(
    json_response=True,
    stateless_http=True,
    transport_security=security,
)
